# =============================================================================
# obsidian-livesync — environment
# =============================================================================
# cp .env.example .env, then fill in. .env is git-ignored; never commit it.
# Generate passwords with:  openssl rand -base64 30 | tr -d '/+=' | cut -c1-32
# =============================================================================

# ── CouchDB server admin ─────────────────────────────────────────────────────
# Stays on the server. Devices never use these credentials.
COUCHDB_USER=couch_admin
COUCHDB_PASSWORD=change-me-admin

# ── Vault database + device user ─────────────────────────────────────────────
# Devices log in as VAULT_USER, which is admin of VAULT_DB only (LiveSync writes
# a _design/chunks doc for garbage collection) and has no server-level rights.
VAULT_DB=obsidian_vault
VAULT_USER=obsidian
VAULT_PASSWORD=change-me-vault

# ── Local port (server loopback) ─────────────────────────────────────────────
COUCHDB_LOCAL_PORT=5984

# ── Tailscale serve ──────────────────────────────────────────────────────────
# URL devices use: https://${TS_HOSTNAME}:${TS_HTTPS_PORT} (tailnet only).
# TS_HOSTNAME is the server's full MagicDNS name; on the server, see it with:
#   tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))'
# 6984 is CouchDB's usual HTTPS port. 443 also works if nothing else on the
# server uses it (serve-on refuses a port that is already taken).
TS_HOSTNAME=your-server.your-tailnet.ts.net
TS_HTTPS_PORT=6984

# ── Deploy from your computer (optional: scripts/deploy.sh) ──────────────────
# Only needed if you push files from your computer instead of cloning the repo
# on the server. DEPLOY_HOST is the server's Tailscale name or 100.x address;
# DEPLOY_USER needs sudo and must be in the server's docker group.
DEPLOY_HOST=your-server
DEPLOY_USER=deploy
REMOTE_DIR=/opt/obsidian-livesync

# ── Backups (server) ─────────────────────────────────────────────────────────
# A snapshot is taken weekly (Sunday 03:30, deploy/systemd/). Each one is a full
# copy of the database; the newest BACKUP_KEEP are kept (4 = the last four weeks).
BACKUP_DIR=/opt/obsidian-livesync/backups
BACKUP_KEEP=4
